#!/bin/sh
# tabi: install and update the tabi layout for Herdr (macOS and Linux).
# The Herdr config folder is a git checkout of this repository, so installing is a clone into it
# and updating is a fast-forward pull. Nothing outside tracked files is ever touched.
set -eu

VERSION="0.4.0"
REPO="${TABI_REPO:-https://github.com/LeoSle4/herdr-tabi.git}"
BRANCH="${TABI_BRANCH:-main}"

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

need_git() { command -v git >/dev/null 2>&1 || die "git is required: install it and run this again"; }

default_dir() {
  if [ -n "${HERDR_APP_HOME:-}" ]; then printf '%s\n' "$HERDR_APP_HOME"; return; fi
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/herdr-app"
}

restart_notice() { say "Restart Herdr to load the new version."; }

cmd_install() {
  dir=$1
  need_git
  if [ -d "$dir/.git" ]; then
    say "$dir is already a checkout: updating it"
    cmd_update "$dir"
    return
  fi
  say "Installing tabi into $dir"
  mkdir -p "$dir"
  git -C "$dir" init -q
  git -C "$dir" remote add origin "$REPO"
  git -C "$dir" fetch -q origin "$BRANCH" || die "could not fetch $REPO ($BRANCH)"

  # Keep a copy of every file the checkout is about to replace, so nothing of yours is lost.
  backup="$dir/.tabi-backup-$(date +%Y%m%d-%H%M%S)"
  git -C "$dir" ls-tree -r --name-only "origin/$BRANCH" | while IFS= read -r f; do
    [ -f "$dir/$f" ] || continue
    mine=$(git -C "$dir" hash-object "$dir/$f")
    theirs=$(git -C "$dir" rev-parse "origin/$BRANCH:$f")
    [ "$mine" = "$theirs" ] && continue
    mkdir -p "$backup/$(dirname "$f")"
    cp -p "$dir/$f" "$backup/$f"
  done
  [ -d "$backup" ] && say "Your previous versions were saved in $backup"

  git -C "$dir" checkout -q -f -B "$BRANCH" "origin/$BRANCH"
  git -C "$dir" branch -q --set-upstream-to="origin/$BRANCH" "$BRANCH"
  say "Installed $(git -C "$dir" rev-parse --short HEAD)"
  restart_notice
}

cmd_update() {
  dir=$1
  need_git
  [ -d "$dir/.git" ] || die "$dir is not a tabi checkout: run 'tabi install' first"
  current=$(git -C "$dir" symbolic-ref --short -q HEAD || true)
  [ "$current" = "$BRANCH" ] || die "$dir is on '${current:-a detached HEAD}', not '$BRANCH': switch to $BRANCH first"
  if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]; then
    die "you have local changes in $dir: commit or discard them, then run this again"
  fi
  before=$(git -C "$dir" rev-parse HEAD)
  git -C "$dir" fetch -q origin "$BRANCH" || die "could not fetch $REPO ($BRANCH)"
  git -C "$dir" merge -q --ff-only "origin/$BRANCH" || die "your $BRANCH diverged from origin/$BRANCH: resolve it by hand"
  after=$(git -C "$dir" rev-parse HEAD)
  refresh_self "$dir"
  if [ "$before" = "$after" ]; then
    say "Already up to date ($(git -C "$dir" rev-parse --short HEAD))"
  else
    say "Updated $(git -C "$dir" rev-parse --short "$before") -> $(git -C "$dir" rev-parse --short "$after")"
    restart_notice
  fi
}

ask_extras() {
  # Offer the terminal extras after an install. Flags decide without asking; with no terminal to ask on, never ask.
  [ "$no_shell" = 1 ] && return 1
  [ "$with_shell" = 1 ] && return 0
  ( : < /dev/tty ) 2>/dev/null || return 1
  printf 'Install the terminal extras (Starship prompt, autocompletion, zoxide, fzf, eza, bat)? [y/N] ' > /dev/tty
  read -r answer < /dev/tty || return 1
  case $answer in y | Y | yes | YES | s | S | si | SI | sí) return 0 ;; *) return 1 ;; esac
}

install_packages() {
  if ! command -v brew >/dev/null 2>&1; then
    say "Homebrew was not found: install these with your package manager: starship zoxide fzf eza bat zsh-autosuggestions zsh-syntax-highlighting"
    return
  fi
  for pkg in starship zoxide fzf eza bat zsh-autosuggestions zsh-syntax-highlighting; do
    brew list --formula "$pkg" >/dev/null 2>&1 && continue
    say "Installing $pkg with Homebrew"
    brew install "$pkg" || say "could not install $pkg: install it by hand"
  done
  # A Nerd Font for terminals that do not draw the branch symbol themselves (Ghostty and Herdr already do).
  if [ "$(uname -s)" = Darwin ] && ! brew list --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1; then
    say "Installing the JetBrainsMono Nerd Font with Homebrew"
    brew install --cask font-jetbrains-mono-nerd-font || say "could not install the Nerd Font: install it by hand"
  fi
}

wire_rc() {
  dir=$1
  case $(basename "${SHELL:-}") in
    zsh) rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *) say "Your shell is not zsh or bash: add these two lines to its startup file:"
       printf 'export TABI_SHELL_DIR="%s/shell"\n[ -f "$TABI_SHELL_DIR/profile.sh" ] && . "$TABI_SHELL_DIR/profile.sh"\n' "$dir"
       return ;;
  esac
  start='# >>> tabi shell >>>'
  end='# <<< tabi shell <<<'
  touch "$rc"
  [ -e "$rc.tabi-backup" ] || cp -p "$rc" "$rc.tabi-backup"
  if ! grep -qF "$start" "$rc" && grep -qE 'starship init|zoxide init' "$rc"; then
    say "Note: $rc already starts Starship or zoxide by itself; the tabi block is harmless, but you can drop your own lines."
  fi
  # Drop an earlier tabi block, then add the current one at the end (syntax highlighting must load last).
  tmp=$(mktemp)
  awk -v s="$start" -v e="$end" '$0 == s { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$rc" > "$tmp"
  {
    cat "$tmp"
    printf '%s\nexport TABI_SHELL_DIR="%s/shell"\n[ -f "$TABI_SHELL_DIR/profile.sh" ] && . "$TABI_SHELL_DIR/profile.sh"\n%s\n' "$start" "$dir" "$end"
  } > "$rc"
  rm -f "$tmp"
  say "Updated $rc (your previous copy is $rc.tabi-backup)"
}

cmd_shell() {
  dir=$1
  [ -f "$dir/shell/profile.sh" ] || die "$dir/shell/profile.sh not found: run 'tabi update' first"
  [ "$no_install" = 1 ] || install_packages
  wire_rc "$dir"
  say "Open a new terminal to see it."
}

# A command installed by install.sh (in ~/.local/bin) follows the repository; one managed by Homebrew does not.
refresh_self() {
  dir=$1
  bindir="${TABI_BIN:-$HOME/.local/bin}"
  me=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || return 0
  [ "$me" = "$(cd "$bindir" 2>/dev/null && pwd)" ] || return 0
  [ -f "$dir/bin/tabi" ] || return 0
  cmp -s "$dir/bin/tabi" "$me/tabi" && return 0
  cp "$dir/bin/tabi" "$me/tabi.new" && chmod +x "$me/tabi.new" && mv "$me/tabi.new" "$me/tabi" && say "Updated the tabi command"
}

memory_dir() { printf '%s\n' "${TABI_MEMORY_DIR:-$HOME/engram-memory}"; }

# Engram memories hold everything said to the agents: they may only go to a repository confirmed private.
memory_check() {
  mdir=$1
  command -v engram >/dev/null 2>&1 || die "engram is not installed (gentle-ai installs it)"
  [ -d "$mdir/.git" ] || die "$mdir is not a git checkout: clone your private memory repository there, or set TABI_MEMORY_DIR"
  url=$(git -C "$mdir" remote get-url origin 2>/dev/null) || die "$mdir has no 'origin' remote"
  case $url in *herdr-tabi*) die "refusing: $url is the public tabi repository; memories must go to a private one" ;; esac
  [ "${TABI_MEMORY_TRUST:-0}" = 1 ] && return 0
  command -v gh >/dev/null 2>&1 || die "cannot confirm the repository is private without gh: install it, or set TABI_MEMORY_TRUST=1 if you are sure"
  [ "$(cd "$mdir" && gh repo view --json isPrivate -q .isPrivate 2>/dev/null)" = true ] ||
    die "$url is not confirmed private (gh repo view): memories hold everything you told your agents"
}

cmd_memory() {
  sub=$1
  need_git
  mdir=$(memory_dir)
  case $sub in
    push)
      memory_check "$mdir"
      git -C "$mdir" ls-remote --exit-code origin HEAD >/dev/null 2>&1 &&
        { git -C "$mdir" pull -q --rebase || die "could not update $mdir from origin"; }
      (cd "$mdir" && engram sync --all) || die "engram sync failed"
      if [ -z "$(git -C "$mdir" status --porcelain -- .engram)" ]; then say "Nothing new to send"; return; fi
      git -C "$mdir" add .engram
      git -C "$mdir" commit -q -m "memory: $(hostname) $(date +%Y-%m-%d)" || die "could not commit in $mdir (is your git identity set?)"
      git -C "$mdir" push -q -u origin HEAD 2>/dev/null ||
        { git -C "$mdir" pull -q --rebase && git -C "$mdir" push -q -u origin HEAD; } || die "could not push $mdir"
      say "Memories sent"
      ;;
    pull)
      memory_check "$mdir"
      git -C "$mdir" pull -q --ff-only || die "could not update $mdir from origin"
      (cd "$mdir" && engram sync --import) || die "engram sync --import failed"
      say "Memories imported"
      ;;
    status)
      command -v engram >/dev/null 2>&1 || die "engram is not installed (gentle-ai installs it)"
      [ -d "$mdir" ] || die "$mdir does not exist: clone your private memory repository there, or set TABI_MEMORY_DIR"
      (cd "$mdir" && engram sync --status)
      ;;
    *) die "usage: tabi memory push | pull | status" ;;
  esac
}

# net-watch: keeps Tailscale (and so the link between your machines and the phone) up.
# `run` is one check: healthy -> nothing; offline -> up to 3 repairs (down/up), one per run; still offline -> one ntfy alert.
NW_LABEL="dev.tabi.net-watch"
NW_MAX_REPAIRS=3

nw_tailscale() {
  if [ -n "${TABI_TAILSCALE+x}" ]; then
    if [ -x "$TABI_TAILSCALE" ]; then printf '%s\n' "$TABI_TAILSCALE"; return; fi
    return 1
  fi
  for c in "$(command -v tailscale 2>/dev/null || true)" /usr/local/bin/tailscale /opt/homebrew/bin/tailscale \
    /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
    if [ -n "$c" ] && [ -x "$c" ]; then printf '%s\n' "$c"; return; fi
  done
  return 1
}

nw_healthy() {
  out=$("$1" status --json 2>/dev/null) || return 1
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$out" | python3 -c 'import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get("BackendState")=="Running" and (d.get("Self") or {}).get("Online") else 1)' 2>/dev/null
  else
    printf '%s' "$out" | grep -q '"BackendState": *"Running"'
  fi
}

# Reads the ntfy settings of the notification file (the same one the agents' alerts use) and sends one message.
nw_alert() {
  cfg="$1/data/tabi/notify.json"
  [ -f "$cfg" ] && command -v python3 >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 || return 0
  set -- "$cfg" "$(hostname -s 2>/dev/null || echo this-machine)"
  fields=$(python3 - "$@" <<'PY' 2>/dev/null || true
import json, re, sys
c = json.load(open(sys.argv[1]))
t, s = c.get("topic", ""), c.get("server", "https://ntfy.sh")
if not (isinstance(t, str) and re.fullmatch(r"[A-Za-z0-9_-]{8,64}", t) and isinstance(s, str) and s.startswith("https://")):
    sys.exit(0)
body = "Tailscale is offline and the automatic repair did not work"
if c.get("details") is True:
    body += " on " + sys.argv[2]
print(s.rstrip("/") + "/" + t)
print(body)
PY
)
  [ -n "$fields" ] || return 0
  url=$(printf '%s\n' "$fields" | sed -n 1p)
  body=$(printf '%s\n' "$fields" | sed -n 2p)
  curl -fsS -m 10 -H "Title: tabi net-watch" -H "Priority: 4" -d "$body" "$url" >/dev/null 2>&1 || true
}

# Machines that lost their link while Tailscale was down get reconnected now instead of at their next retry.
nw_reconnect() {
  command -v hc >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1 || return 0
  hc machine ls 2>/dev/null | python3 -c 'import json,sys
for m in json.load(sys.stdin).get("machines", []):
    if m.get("state") != "connected": print(m.get("name", ""))' 2>/dev/null | while read -r name; do
    [ -n "$name" ] && hc machine login "$name" >/dev/null 2>&1 || true
  done
}

# 'tailscale up' refuses to run when your settings differ from the defaults (for example --accept-routes) and prints the
# command that keeps them; run exactly that one so a repair never changes your settings.
nw_up() {
  upout=$("$1" up --timeout=20s 2>&1) && return 0
  suggested=$(printf '%s\n' "$upout" | sed -n 's/^[[:space:]]*tailscale up //p' | tail -n 1)
  [ -n "$suggested" ] || return 1
  # shellcheck disable=SC2086
  "$1" up $suggested >/dev/null 2>&1
}

nw_run() {
  dir=$1
  ts=$(nw_tailscale) || { say "net-watch: tailscale is not installed, nothing to watch"; return 0; }
  state="$dir/data/tabi/net-watch.state"
  if nw_healthy "$ts"; then
    if [ -f "$state" ]; then rm -f "$state"; say "net-watch: Tailscale is back"; nw_reconnect; fi
    return 0
  fi
  mkdir -p "$dir/data/tabi"
  attempts=0; alerted=0
  [ -f "$state" ] && { read -r attempts alerted < "$state" || true; }
  case $attempts in '' | *[!0-9]*) attempts=0 ;; esac
  case $alerted in '' | *[!0-9]*) alerted=0 ;; esac
  if [ "$attempts" -lt "$NW_MAX_REPAIRS" ]; then
    attempts=$((attempts + 1))
    printf '%s %s\n' "$attempts" "$alerted" > "$state"
    say "net-watch: Tailscale is offline, repair $attempts of $NW_MAX_REPAIRS"
    "$ts" down >/dev/null 2>&1 || true
    sleep "${TABI_NETWATCH_WAIT:-3}"
    nw_up "$ts" || say "net-watch: 'tailscale up' failed (run it by hand to see why)"
    sleep "${TABI_NETWATCH_WAIT:-3}"
    if nw_healthy "$ts"; then rm -f "$state"; say "net-watch: Tailscale is back"; nw_reconnect; fi
    return 0
  fi
  if [ "$alerted" -eq 0 ]; then
    printf '%s 1\n' "$attempts" > "$state"
    say "net-watch: still offline after $NW_MAX_REPAIRS repairs, sending the alert"
    nw_alert "$dir"
  fi
}

nw_plist() { printf '%s\n' "$HOME/Library/LaunchAgents/$NW_LABEL.plist"; }

nw_install() {
  dir=$1
  [ "$(uname -s)" = Darwin ] || die "net-watch install uses launchd (macOS); on Linux run 'tabi net-watch run' from cron or a systemd timer every 5 minutes"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$dir/data/tabi" "$HOME/Library/LaunchAgents"
  cat > "$(nw_plist)" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$NW_LABEL</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>$self</string><string>net-watch</string><string>run</string><string>--dir</string><string>$dir</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$dir/data/tabi/net-watch.log</string>
  <key>StandardErrorPath</key><string>$dir/data/tabi/net-watch.log</string>
</dict></plist>
EOF
  if [ -z "${TABI_NETWATCH_NOLOAD:-}" ]; then
    launchctl bootout "gui/$(id -u)/$NW_LABEL" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$(nw_plist)" || die "launchctl could not load $(nw_plist)"
  fi
  say "net-watch installed: it checks Tailscale every 5 minutes (log: $dir/data/tabi/net-watch.log)"
}

nw_remove() {
  if [ -z "${TABI_NETWATCH_NOLOAD:-}" ] && [ "$(uname -s)" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/$NW_LABEL" >/dev/null 2>&1 || true
  fi
  rm -f "$(nw_plist)"
  say "net-watch removed"
}

cmd_netwatch() {
  case $1 in
    run | '') nw_run "$2" ;;
    install) nw_install "$2" ;;
    remove) nw_remove ;;
    *) die "usage: tabi net-watch [run | install | remove]" ;;
  esac
}

cmd_status() {
  dir=$1
  printf 'tabi %s\nfolder: %s\n' "$VERSION" "$dir"
  command -v git >/dev/null 2>&1 && echo "git: ok" || echo "git: MISSING (required)"
  if command -v python3 >/dev/null 2>&1; then echo "python3: ok"; else echo "python3: missing (the sessions and backdrop mods need it)"; fi
  if [ -d "$dir/.git" ]; then echo "checkout: $(git -C "$dir" rev-parse --short HEAD) on $(git -C "$dir" symbolic-ref --short -q HEAD || echo detached)"
  else echo "checkout: not installed (run 'tabi install')"; fi
}

usage() {
  cat <<EOF
tabi $VERSION: install and update the tabi layout for Herdr

Usage: tabi <command> [--dir <folder>] [--with-shell | --no-shell]

Commands:
  install   Set up tabi in the Herdr config folder (updates it if already installed), then offer the
            terminal extras; --with-shell accepts them without asking, --no-shell skips the question
  update    Pull the latest version (fast-forward only; refuses if you have local edits)
  shell     Install the terminal extras (Starship, zoxide, fzf, eza, bat, zsh plugins) and wire your
            ~/.zshrc or ~/.bashrc; --no-install only wires the file
  memory    Share Engram memories between machines through a private git repository:
            push | pull | status (the repository is ~/engram-memory, or \$TABI_MEMORY_DIR)
  net-watch Keep Tailscale up so your machines and phone stay connected: run (one check), install
            (every 5 minutes, macOS launchd), remove. Offline -> 3 automatic repairs, then one ntfy alert
  status    Show the folder, the installed version and what is missing
  version   Print the tool version

The folder defaults to \$HERDR_APP_HOME, else \${XDG_CONFIG_HOME:-~/.config}/herdr-app.
EOF
}

command=${1:-help}
[ $# -gt 0 ] && shift
sub=""
if { [ "$command" = memory ] || [ "$command" = net-watch ]; } && [ $# -gt 0 ]; then
  case $1 in -*) ;; *) sub=$1; shift ;; esac
fi
dir=$(default_dir)
with_shell=0
no_shell=0
no_install=0
while [ $# -gt 0 ]; do
  case $1 in
    --dir) [ $# -ge 2 ] || die "--dir needs a folder"; dir=$2; shift 2 ;;
    --with-shell) with_shell=1; shift ;;
    --no-shell) no_shell=1; shift ;;
    --no-install) no_install=1; shift ;;
    *) die "unknown option: $1" ;;
  esac
done

case $command in
  install) cmd_install "$dir"; if ask_extras; then cmd_shell "$dir"; fi ;;
  shell) cmd_shell "$dir" ;;
  memory) cmd_memory "$sub" ;;
  net-watch) cmd_netwatch "$sub" "$dir" ;;
  update) cmd_update "$dir" ;;
  status) cmd_status "$dir" ;;
  version|--version|-v) echo "tabi $VERSION" ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 1 ;;
esac
